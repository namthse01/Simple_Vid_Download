<Window x:Class="SimpleVidDownload.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhật ký đầy đủ" Height="560" Width="820"
        MinHeight="320" MinWidth="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}" FontSize="13" Icon="appicon.ico"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">

  <Grid Margin="12,10,12,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource Sunken}" CornerRadius="9" Padding="4">
      <TextBox x:Name="TxtFull" IsReadOnly="True" TextWrapping="NoWrap"
               Background="Transparent" BorderThickness="0" Padding="8,6"
               VerticalContentAlignment="Stretch"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
               FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource Text}"/>
    </Border>

    <Grid Grid.Row="1" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="LblNote" Grid.Column="0" VerticalAlignment="Center" FontSize="11.5"
                 Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="BtnCopy" Content="Copy" Style="{StaticResource BtnGhost}"
                Padding="14,6" Margin="0,0,7,0" Click="BtnCopy_Click"/>
        <Button x:Name="BtnSave" Content="Lưu ra file..." Style="{StaticResource BtnGhost}"
                Padding="14,6" Margin="0,0,7,0" Click="BtnSave_Click"/>
        <Button x:Name="BtnClose" Content="Đóng" Style="{StaticResource BtnBase}"
                Padding="18,6" Click="BtnClose_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
