<Window x:Class="SimpleVidDownload.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tải Video — dán link là xong" Height="470" Width="720"
        MinHeight="470" MinWidth="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}" FontSize="13" Icon="appicon.ico"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">

  <!-- Vùng cuộn chỉ là lưới an toàn cho màn hình quá thấp: KHÔNG bao giờ vẽ thanh cuộn
       (lăn chuột vẫn được). Bình thường cửa sổ tự cao thêm cho vừa nội dung — xem GrowToFit(). -->
  <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden"
                HorizontalScrollBarVisibility="Disabled">
  <!-- Lề phải nằm BÊN TRONG phần ràng buộc chiều cao, không thì nội dung luôn cao hơn
       khung nhìn đúng bằng lề và thanh cuộn hiện ra dù cửa sổ vẫn đủ chỗ. -->
  <Border Padding="10,8,10,8" MinHeight="{Binding ViewportHeight, ElementName=Scroller}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ===== đầu trang ===== -->
    <Grid Grid.Row="0" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="LblAppName" Text="Tải Video" FontSize="17" FontWeight="Bold"
                   VerticalAlignment="Center"/>
        <TextBlock x:Name="LblTagline" Text="dán link là xong" Foreground="{StaticResource Muted}"
                   FontSize="11.5" Margin="10,2,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="BtnVi" Content="VI" Style="{StaticResource BtnGhost}"
                Padding="9,5" FontSize="11.5" Margin="0,0,3,0" Click="BtnLang_Click" Tag="vi"/>
        <Button x:Name="BtnEn" Content="EN" Style="{StaticResource BtnGhost}"
                Padding="9,5" FontSize="11.5" Margin="0,0,8,0" Click="BtnLang_Click" Tag="en"/>
        <Button x:Name="BtnUpdate" Content="Cập nhật engine" Style="{StaticResource BtnGhost}"
                Padding="11,5" FontSize="11.5" Click="BtnUpdate_Click"/>
      </StackPanel>
    </Grid>

    <!-- ===== thẻ nhập liệu ===== -->
    <Border Grid.Row="1" Background="{StaticResource Card}" CornerRadius="9"
            Padding="11,9" Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" MinWidth="66"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="LblLink" Grid.Row="0" Grid.Column="0" Text="Link video"
                   Style="{StaticResource Lbl}"/>
        <Grid Grid.Row="0" Grid.Column="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="TxtUrl" Grid.Column="0" KeyDown="TxtUrl_KeyDown"/>
          <TextBlock x:Name="LblUrlHint" Grid.Column="0" IsHitTestVisible="False" Margin="12,0,0,0"
                     FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource Faint}"
                     Text="Dán link video vào đây rồi bấm Enter...">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=TxtUrl}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Button x:Name="BtnPaste" Grid.Column="1" Content="Dán link"
                  Style="{StaticResource BtnBase}" Margin="8,0,0,0" Click="BtnPaste_Click"/>
        </Grid>

        <TextBlock x:Name="LblQuality" Grid.Row="1" Grid.Column="0" Text="Chất lượng"
                   Style="{StaticResource Lbl}" Margin="0,8,12,0"/>
        <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
          <ComboBox x:Name="CboQuality" Width="206" SelectedIndex="0" Margin="0,0,20,0">
            <ComboBoxItem Content="Tốt nhất — 4K nếu có"/>
            <ComboBoxItem Content="Tối đa 1440p (2K)"/>
            <ComboBoxItem Content="Tối đa 1080p"/>
            <ComboBoxItem Content="Tối đa 720p"/>
            <ComboBoxItem Content="Tối đa 480p"/>
            <ComboBoxItem Content="Chỉ lấy âm thanh (MP3)"/>
          </ComboBox>
          <CheckBox x:Name="ChkPlaylist" Content="Tải cả playlist" Margin="0,0,20,0"
                    ToolTip="Dán link playlist và tải toàn bộ"/>
          <StackPanel Orientation="Horizontal">
            <CheckBox x:Name="ChkCookie" Content="Dùng cookie"
                      ToolTip="Cho video riêng tư hoặc giới hạn tuổi — nên chọn edge hoặc firefox"/>
            <ComboBox x:Name="CboBrowser" Width="88" SelectedIndex="0" Margin="8,0,0,0">
              <ComboBoxItem Content="edge"/>
              <ComboBoxItem Content="chrome"/>
              <ComboBoxItem Content="firefox"/>
            </ComboBox>
          </StackPanel>
        </WrapPanel>

        <TextBlock x:Name="LblUpscale" Grid.Row="2" Grid.Column="0" Text="Nâng cấp"
                   Style="{StaticResource Lbl}" Margin="0,8,12,0"/>
        <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
          <CheckBox x:Name="ChkUpscale" Content="Nâng độ phân giải bằng AI"
                    IsEnabled="False" Margin="0,0,14,0"/>
          <ComboBox x:Name="CboUpscale" Width="146" SelectedIndex="0" IsEnabled="False">
            <ComboBoxItem Content="lên 1080p"/>
            <ComboBoxItem Content="lên 1440p (2K)"/>
            <ComboBoxItem Content="lên 4K (2160p)"/>
          </ComboBox>
        </WrapPanel>

        <TextBlock x:Name="LblFolder" Grid.Row="3" Grid.Column="0" Text="Lưu vào"
                   Style="{StaticResource Lbl}" Margin="0,8,12,0"/>
        <Grid Grid.Row="3" Grid.Column="1" Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="TxtFolder" Grid.Column="0"/>
          <Button x:Name="BtnFolder" Grid.Column="1" Content="Chọn..."
                  Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Click="BtnFolder_Click"/>
          <Button x:Name="BtnOpen" Grid.Column="2" Content="Mở thư mục"
                  Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Click="BtnOpen_Click"/>
        </Grid>
      </Grid>
    </Border>

    <!-- ===== hai nút hành động =====
         Dùng WrapPanel + nút cỡ theo nội dung: màn hình rộng thì nút KHÔNG phình ra,
         màn hình hẹp thì nút thứ hai tự xuống dòng. -->
    <WrapPanel Grid.Row="2" Margin="0,0,0,8">
      <Button x:Name="BtnDownload" Content="⬇   TẢI XUỐNG"
              Style="{StaticResource BtnBase}" Background="{StaticResource Go}"
              FontSize="12.5" Padding="16,6" Margin="0,0,7,0" Click="BtnDownload_Click"/>
      <Button x:Name="BtnCapture" Content="🌐  Bắt video từ web"
              Style="{StaticResource BtnBase}" Background="{StaticResource Warn}"
              FontSize="12" Padding="13,6" Click="BtnCapture_Click"
              ToolTip="Mở trình duyệt nhúng để bắt link video — dùng khi dán link báo Unsupported URL"/>
    </WrapPanel>

    <!-- ===== bảng cứu cánh khi tải lỗi =====
         Người dùng gặp lỗi thường nghĩ app hỏng rồi bỏ đi, chứ không biết còn chế độ
         bắt video. Nên khi lỗi thì đập thẳng vào mặt một bảng vàng kèm nút to. -->
    <Border x:Name="PanelRescue" Grid.Row="3" Visibility="Collapsed"
            Background="{StaticResource Warn}" CornerRadius="9" Padding="12,10" Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="LblRescueTitle" Foreground="{StaticResource Ink}"
                     FontWeight="Bold" FontSize="13" Text="Trang này không tải thẳng được"/>
          <TextBlock x:Name="LblRescueBody" Foreground="{StaticResource Ink}" FontSize="11.5"
                     TextWrapping="Wrap" Margin="0,3,0,0" Opacity="0.85" Text=""/>
        </StackPanel>
        <Button x:Name="BtnRescue" Grid.Column="1" VerticalAlignment="Center"
                Style="{StaticResource BtnBase}" Background="{StaticResource Ink}"
                Foreground="{StaticResource Warn}" Padding="16,8" FontSize="12.5"
                Content="🌐  Thử cách này" Click="BtnRescue_Click"/>
      </Grid>
    </Border>

    <!-- ===== tiến độ + trạng thái ===== -->
    <Border Grid.Row="4" Background="{StaticResource Card}" CornerRadius="9"
            Padding="11,8" Margin="0,0,0,8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ProgressBar x:Name="Pb" Grid.Row="0" Minimum="0" Maximum="100"/>
        <Grid Grid.Row="1" Margin="0,7,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="LblStatus" Grid.Column="0" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                     Foreground="{StaticResource Muted}"
                     Text="Sẵn sàng — dán link rồi bấm TẢI XUỐNG (hoặc Enter)."/>
          <Button x:Name="BtnOpenVideo" Grid.Column="1" Content="▶  Mở video"
                  Style="{StaticResource BtnBase}" Padding="12,5" FontSize="11.5"
                  IsEnabled="False" Click="BtnOpenVideo_Click"/>
        </Grid>
      </Grid>
    </Border>

    <!-- ===== nhật ký ===== -->
    <Grid Grid.Row="5">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,4">
        <TextBlock x:Name="LblLogHeader" Text="NHẬT KÝ" FontSize="10.5" Margin="2,0,0,0"
                   VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
        <Button x:Name="BtnLog" Content="Xem đầy đủ" Style="{StaticResource BtnGhost}"
                HorizontalAlignment="Right" Padding="9,3" FontSize="11"
                Click="BtnLog_Click"/>
      </Grid>
      <Border Grid.Row="1" Background="{StaticResource Sunken}" CornerRadius="9" Padding="4" MinHeight="30">
        <Grid>
          <!-- Chi de liec qua vai dong cuoi: KHONG cuon, KHONG xuong dong.
               Muon xem het thi bam nut "Xem day du". -->
          <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="NoWrap"
                   Background="Transparent" BorderThickness="0" Padding="8,5"
                   IsHitTestVisible="False" Focusable="False"
                   VerticalContentAlignment="Top"
                   VerticalScrollBarVisibility="Disabled"
                   HorizontalScrollBarVisibility="Disabled"
                   FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource Muted}"/>
          <TextBlock x:Name="LblLogHint" IsHitTestVisible="False" Margin="10,8,0,0" FontSize="12"
                     VerticalAlignment="Top" HorizontalAlignment="Left" Foreground="#585B70"
                     Text="Tiến trình tải sẽ hiện ở đây.">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=TxtLog}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Border>
    </Grid>
  </Grid>
  </Border>
  </ScrollViewer>
</Window>
